# ============================================================================
# SempliceMente Bimbi — variabili d'ambiente
# ============================================================================
#
# Copia questo file in .env.local e riempi i valori:
#     cp .env.example .env.local
#
# .env.local è ignorato da git: NON committarlo mai.
#
# Su Vercel le stesse variabili vanno in Settings → Environment Variables,
# scegliendo lo scope giusto (Production / Preview / Development).
# Vedi DEVELOPMENT.md per quali valori usare in ciascun ambiente.
# ============================================================================


# --- Supabase (obbligatorie) ------------------------------------------------

# URL del progetto Supabase.
# Dashboard → Settings → API → Project URL
#
# ⚠️  IMPORTANTE: in locale e nelle preview usa il progetto Supabase di SVILUPPO,
#     mai quello di produzione. L'app scrive sul DB con la service key e senza
#     RLS: un test può cancellare i dati reali delle famiglie.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Chiave service_role (segreta, accesso totale al DB, bypassa RLS).
# Dashboard → Settings → API → service_role → Reveal
# Usata solo lato server in lib/supabase.ts. Non esporla mai al browser.
SUPABASE_SERVICE_KEY=

# Nome del bucket Storage per le foto (crealo come bucket PUBBLICO).
SUPABASE_STORAGE_BUCKET=photos


# --- Sessione (obbligatoria) ------------------------------------------------

# Chiave di cifratura dei cookie di sessione (iron-session, lib/session.ts).
# Minimo 32 caratteri. Usa un valore DIVERSO per ogni ambiente: così una
# sessione di test non è valida in produzione.
#
# Genera con:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=


# --- Email (opzionali) ------------------------------------------------------

# API key di Resend, per l'invio delle email di annuncio.
#
# 💡 In locale e nelle preview LASCIA VUOTO: il codice salta l'invio invece di
#    fallire, così non rischi di mandare email vere durante i test.
RESEND_API_KEY=

# Mittente delle email. Se non impostato usa:
#     SempliceMente Bimbi <news@semplicementebimbi.it>
EMAIL_FROM=

# Segreto che protegge l'endpoint /api/admin/announce (invio annunci in massa).
# Serve solo se usi scripts/send-announcement.mjs.
# Genera come SESSION_SECRET. Se vuoto, l'endpoint è disattivato.
ANNOUNCE_SECRET=
